{
  "name": "four-banners",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "谋定山河：本地玩家与电脑的轻量策略小游戏",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "balance:audit": "node scripts/balance-audit.mjs",
    "benchmark": "node --expose-gc scripts/benchmark.mjs",
    "visual": "node scripts/visual.mjs",
    "runtime": "node scripts/runtime.mjs",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
